# RPC URL for the target network
RPC_URL=katana_rpc_url

# Private key for deployment (without 0x prefix)
PRIVATE_KEY=private_key

# SushiSwap NFT Position Manager Contract Address
SUSHI_NFT_CONTRACT=sushi_nft_contract_address

# SushiSwap V3 Factory Contract Address 
FACTORY_CONTRACT=factory_contract_address

# Fee collector address (receives fees from staked positions)
FEE_COLLECTOR=fee_collector_address

# Owner address for the staker contract and proxy admin
OWNER_ADDRESS=owner_address

# Etherscan API key for verification
ETHERSCAN_API_KEY=etherscan_api_key
